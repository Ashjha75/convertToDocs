# ==============================================================================
# 5. GENERATOR EXECUTION
# ==============================================================================

try:
    # 1. Validate
    print("Validating JSON...")
    config = PresentationConfig(**input_json)
    
    # 2. Initialize
    print("Generating Slides...")
    prs = Presentation()
    prs.slide_width = Inches(13.333) # 16:9 Aspect Ratio
    prs.slide_height = Inches(7.5)
    
    # 3. Render Loop
    for slide_data in config.slides:
        # Use Blank Layout (index 6) for maximum control
        slide = prs.slides.add_slide(prs.slide_layouts[6])
        
        if slide_data.type == "cover":
            render_cover(prs, slide, slide_data, config.theme)
        elif slide_data.type == "content":
            render_content(prs, slide, slide_data, config.theme)
        elif slide_data.type == "table":
            render_table(prs, slide, slide_data, config.theme)
        elif slide_data.type == "chart":
            render_chart(prs, slide, slide_data, config.theme)
        elif slide_data.type == "cards":
            render_cards(prs, slide, slide_data, config.theme)
        elif slide_data.type == "gantt":
            render_gantt(prs, slide, slide_data, config.theme)
        elif slide_data.type == "image":
            render_image(prs, slide, slide_data, config.theme)

    # 4. Save and Download
    prs.save(config.file_name)
    print(f"✅ Success! Generated {config.file_name}")
    
    # Generate Download Link
    with open(config.file_name, "rb") as f:
        b64 = base64.b64encode(f.read()).decode()
    
    href = f'<a href="data:application/vnd.openxmlformats-officedocument.presentationml.presentation;base64,{b64}" download="{config.file_name}" style="background-color: #0078d4; color: white; padding: 10px 20px; text-decoration: none; font-weight: bold; border-radius: 5px;">⬇️ DOWNLOAD POWERPOINT</a>'
    display(HTML(href))

except ValidationError as e:
    print("❌ JSON ERROR: Your data doesn't match the required format.")
    print(e)
except Exception as e:
    print(f"❌ SYSTEM ERROR: {str(e)}")
