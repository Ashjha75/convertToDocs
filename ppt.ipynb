### 🟦 CELL 2: Imports & Configuration
```python
import collections 
import collections.abc
from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
from pptx.dml.color import RGBColor
from pptx.enum.shapes import MSO_SHAPE
from pptx.chart.data import CategoryChartData
from pptx.enum.chart import XL_CHART_TYPE, XL_LEGEND_POSITION
import json
import os
import base64
from typing import List, Optional, Union, Literal, Dict, Any
from pydantic import BaseModel, Field, ValidationError
from IPython.display import display, HTML

# ==========================================
# 🎨 THEME & DATA MODELS
# ==========================================

class ThemeColors(BaseModel):
    background: List[int] = [255, 255, 255]
    title_text: List[int] = [0, 0, 0]        # Black (from screenshot)
    body_text: List[int] = [50, 50, 50]      # Dark Grey
    accent_bar: List[int] = [230, 230, 250]  # Light Lavender (from timeline banner)
    table_header: List[int] = [245, 245, 245]
    success: List[int] = [0, 153, 51]        # Green (Completed)
    processing: List[int] = [0, 112, 192]    # Blue (In Progress)
    danger: List[int] = [255, 0, 0]          # Red (Risk/Pending)

class ThemeFonts(BaseModel):
    # Supreme Ventures style: Serif for titles, Sans for body
    family_title: str = "Times New Roman"
    family_body: str = "Arial"
    size_title: int = 36
    size_subtitle: int = 14
    size_body: int = 11

class PresentationTheme(BaseModel):
    colors: ThemeColors = ThemeColors()
    fonts: ThemeFonts = ThemeFonts()

# --- Slide Structure Models ---

class SlideCover(BaseModel):
    type: Literal["cover"]
    title: str
    subtitle: Optional[str] = ""
    date_version: Optional[str] = ""

class SlideContent(BaseModel):
    type: Literal["content"]
    title: str
    banner_text: Optional[str] = None # The colored box from your screenshot
    text: str

class SlideTable(BaseModel):
    type: Literal["table"]
    title: str
    columns: List[Dict[str, str]] # [{"key": "phase", "label": "Phase"}]
    rows: List[Dict[str, Any]]

class SlideChart(BaseModel):
    type: Literal["chart"]
    title: str
    chart_type: Literal["COLUMN", "BAR", "LINE", "PIE"] = "COLUMN"
    categories: List[str]
    series_name: str
    values: List[float]

class GanttTask(BaseModel):
    name: str
    start_week: int
    duration: int
    progress: int = 0

class SlideGantt(BaseModel):
    type: Literal["gantt"]
    title: str
    total_weeks: int = 12
    tasks: List[GanttTask]

class SlideImage(BaseModel):
    type: Literal["image"]
    title: str
    image_path: str
    caption: Optional[str] = ""

SlideType = Union[SlideCover, SlideContent, SlideTable, SlideChart, SlideGantt, SlideImage]

class PresentationConfig(BaseModel):
    file_name: str = "Corporate_Report.pptx"
    theme: PresentationTheme = PresentationTheme()
    slides: List[SlideType]
```

### 🟦 CELL 3: The "Supreme Ventures" Renderer Engine
This contains the logic to replicate your specific design (Table colors, Font styles).

```python
def get_rgb(c): return RGBColor(c[0], c[1], c[2])

def add_header(slide, title, theme):
    """Adds the standard corporate header"""
    # Title (Serif, Bold, Black)
    shape = slide.shapes.add_textbox(Inches(0.5), Inches(0.4), Inches(12.33), Inches(1))
    p = shape.text_frame.paragraphs[0]
    p.text = title
    p.font.name = theme.fonts.family_title
    p.font.size = Pt(32)
    p.font.bold = True
    p.font.color.rgb = get_rgb(theme.colors.title_text)

def render_cover(slide, data: SlideCover, theme):
    # 1. Logos (Dynamic placement if files exist)
    if os.path.exists("logo_left.png"):
        slide.shapes.add_picture("logo_left.png", Inches(0.5), Inches(2.0), height=Inches(1.2))
    if os.path.exists("logo_right.png"):
        pic = slide.shapes.add_picture("logo_right.png", Inches(10), Inches(0.5), height=Inches(0.8))
        pic.left = int(Inches(13.33) - pic.width - Inches(0.5))

    # 2. Main Title (Centered vertically relative to content area)
    box = slide.shapes.add_textbox(Inches(0.5), Inches(4.0), Inches(12), Inches(2))
    p = box.text_frame.paragraphs[0]
    p.text = data.title
    p.font.name = theme.fonts.family_title
    p.font.size = Pt(44)
    p.font.bold = True
    p.font.color.rgb = get_rgb(theme.colors.title_text)

    # 3. Subtitle / Version Info
    sub = slide.shapes.add_textbox(Inches(0.5), Inches(5.2), Inches(12), Inches(1))
    p = sub.text_frame.paragraphs[0]
    p.text = f"{data.subtitle}\n{data.date_version}"
    p.font.name = theme.fonts.family_title
    p.font.size = Pt(16)
    p.font.color.rgb = get_rgb(theme.colors.body_text)

def render_content(slide, data: SlideContent, theme):
    top_cursor = 1.5
    
    # 1. Colored Banner (The Lavender box from your screenshot)
    if data.banner_text:
        box = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0.5), Inches(top_cursor), Inches(12.33), Inches(0.8))
        box.fill.solid()
        box.fill.fore_color.rgb = get_rgb(theme.colors.accent_bar)
        box.line.color.rgb = RGBColor(200, 200, 200) # Subtle border
        
        p = box.text_frame.paragraphs[0]
        p.text = data.banner_text
        p.font.color.rgb = RGBColor(0,0,0)
        p.font.size = Pt(12)
        p.alignment = PP_ALIGN.LEFT
        box.text_frame.margin_left = Inches(0.2)
        top_cursor += 1.0

    # 2. Body Text
    tb = slide.shapes.add_textbox(Inches(0.5), Inches(top_cursor), Inches(12.33), Inches(4))
    tf = tb.text_frame
    tf.word_wrap = True
    p = tf.paragraphs[0]
    p.text = data.text
    p.font.name = theme.fonts.family_body
    p.font.size = Pt(18)

def render_table(slide, data: SlideTable, theme):
    rows = len(data.rows) + 1
    cols = len(data.columns)
    
    # Create Table
    shape = slide.shapes.add_table(rows, cols, Inches(0.5), Inches(1.8), Inches(12.33), Inches(0.5*rows))
    table = shape.table
    
    # --- HEADERS ---
    for i, col in enumerate(data.columns):
        cell = table.cell(0, i)
        cell.text = col['label']
        cell.fill.solid()
        cell.fill.fore_color.rgb = get_rgb(theme.colors.table_header)
        p = cell.text_frame.paragraphs[0]
        p.font.bold = True
        p.font.size = Pt(12)
        p.font.name = theme.fonts.family_title

    # --- ROWS with "Traffic Light" Logic ---
    for r, row_data in enumerate(data.rows, start=1):
        for c, col_def in enumerate(data.columns):
            key = col_def['key']
            cell = table.cell(r, c)
            val = str(row_data.get(key, ""))
            
            # Zebra Striping (White vs Very Light Grey)
            cell.fill.solid()
            cell.fill.fore_color.rgb = RGBColor(255,255,255) if r % 2 == 0 else RGBColor(250,250,250)
            
            # Content Formatting
            p = cell.text_frame.paragraphs[0]
            p.font.size = Pt(11)
            p.font.name = theme.fonts.family_body
            p.font.color.rgb = get_rgb(theme.colors.body_text)

            # 🚦 STATUS LOGIC (Matches your screenshot colors)
            if key == "status":
                val_lower = val.lower()
                if "completed" in val_lower:
                    p.font.color.rgb = get_rgb(theme.colors.success)
                    cell.text = "☑ " + val # Add checkbox symbol
                elif "progress" in val_lower:
                    p.font.color.rgb = get_rgb(theme.colors.processing)
                    cell.text = "🔄 " + val
                elif "pending" in val_lower or "risk" in val_lower:
                    p.font.color.rgb = get_rgb(theme.colors.danger)
                    cell.text = "⚠️ " + val
                else:
                    cell.text = val
            else:
                cell.text = val

def render_chart(slide, data: SlideChart, theme):
    chart_data = CategoryChartData()
    chart_data.categories = data.categories
    chart_data.add_series(data.series_name, data.values)
    
    c_type = getattr(XL_CHART_TYPE, f"{data.chart_type}_CLUSTERED", XL_CHART_TYPE.COLUMN_CLUSTERED)
    if data.chart_type == "LINE": c_type = XL_CHART_TYPE.LINE
    if data.chart_type == "PIE": c_type = XL_CHART_TYPE.PIE

    chart = slide.shapes.add_chart(c_type, Inches(0.5), Inches(2.0), Inches(12), Inches(4.5), chart_data).chart
    chart.has_legend = True
    chart.legend.position = XL_LEGEND_POSITION.BOTTOM

def render_gantt(slide, data: SlideGantt, theme):
    # A simple engine to draw a Gantt chart using shapes
    start_x = 3.0
    start_y = 2.0
    row_h = 0.6
    chart_w = 9.5
    week_w = chart_w / data.total_weeks

    # Header (Weeks)
    for w in range(1, data.total_weeks + 1):
        x = start_x + ((w-1) * week_w)
        tb = slide.shapes.add_textbox(Inches(x), Inches(start_y - 0.4), Inches(week_w), Inches(0.4))
        p = tb.text_frame.paragraphs[0]
        p.text = f"W{w}"
        p.font.size = Pt(10)
        p.alignment = PP_ALIGN.CENTER
        
        # Gridline
        line = slide.shapes.add_shape(MSO_SHAPE.LINE_INVERSE, Inches(x), Inches(start_y), Inches(0), Inches(len(data.tasks)*row_h))
        line.line.color.rgb = RGBColor(220,220,220)

    # Tasks
    for i, task in enumerate(data.tasks):
        y = start_y + (i * row_h)
        # Task Name
        tb = slide.shapes.add_textbox(Inches(0.5), Inches(y), Inches(2.4), Inches(row_h))
        p = tb.text_frame.paragraphs[0]
        p.text = task.name
        p.font.size = Pt(12)
        p.alignment = PP_ALIGN.RIGHT
        
        # Bar
        bar_x = start_x + ((task.start_week - 1) * week_w)
        bar_w = task.duration * week_w
        bar = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(bar_x), Inches(y+0.1), Inches(bar_w), Inches(row_h-0.2))
        bar.fill.solid()
        
        # Color based on progress
        if task.progress == 100: bar.fill.fore_color.rgb = get_rgb(theme.colors.success)
        else: bar.fill.fore_color.rgb = get_rgb(theme.colors.processing)
        
        # Text inside bar
        if task.progress > 0:
            p = bar.text_frame.paragraphs[0]
            p.text = f"{task.progress}%"
            p.font.size = Pt(9)
            p.font.color.rgb = RGBColor(255,255,255)

def render_image(slide, data: SlideImage, theme):
    if os.path.exists(data.image_path):
        pic = slide.shapes.add_picture(data.image_path, Inches(1), Inches(2), height=Inches(4.5))
        pic.left = int((Inches(13.33) - pic.width)/2)
    else:
        tb = slide.shapes.add_textbox(Inches(1), Inches(3), Inches(10), Inches(2))
        tb.text_frame.text = f"Image Not Found: {data.image_path}"
```

