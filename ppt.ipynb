### 🟦 CELL 5: GENERATE & DOWNLOAD
```python
try:
    # 1. Validate Data
    print("⚙️ Validating JSON structure...")
    config = PresentationConfig(**raw_json)
    
    # 2. Init PPT
    prs = Presentation()
    prs.slide_width = Inches(13.333) # Wide Screen 16:9
    prs.slide_height = Inches(7.5)
    
    # 3. Generate Slides
    print("🎨 Rendering Slides...")
    for slide_data in config.slides:
        # Use blank layout for full control
        slide = prs.slides.add_slide(prs.slide_layouts[6])
        
        # Common: Add Header (except cover)
        if slide_data.type != "cover":
            add_header(slide, slide_data.title, config.theme)
            
        # Router
        if slide_data.type == "cover": render_cover(slide, slide_data, config.theme)
        elif slide_data.type == "content": render_content(slide, slide_data, config.theme)
        elif slide_data.type == "table": render_table(slide, slide_data, config.theme)
        elif slide_data.type == "chart": render_chart(slide, slide_data, config.theme)
        elif slide_data.type == "gantt": render_gantt(slide, slide_data, config.theme)
        elif slide_data.type == "image": render_image(slide, slide_data, config.theme)

    # 4. Save & Link
    output_file = config.file_name
    prs.save(output_file)
    
    with open(output_file, "rb") as f:
        b64 = base64.b64encode(f.read()).decode()
        
    print(f"✅ SUCCESS! Presentation Generated.")
    
    # HTML Download Button
    download_btn = f'''
    <a href="data:application/vnd.openxmlformats-officedocument.presentationml.presentation;base64,{b64}" 
       download="{output_file}" 
       style="display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; 
              text-decoration: none; font-family: Arial; font-weight: bold; border-radius: 5px;">
       ⬇️ DOWNLOAD {output_file}
    </a>
    '''
    display(HTML(download_btn))

except ValidationError as e:
    print("❌ JSON ERROR: Please check your input format.")
    print(e)
except Exception as e:
    print(f"❌ ERROR: {e}")
```
