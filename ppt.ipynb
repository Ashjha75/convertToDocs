# ==============================================================================
# 2. DATA MODELS (THE "CONTRACT")
# ==============================================================================
# This ensures your JSON is perfect. If you miss a field, it throws a clear error.

class ThemeColors(BaseModel):
    background: List[int] = [255, 255, 255]
    primary: List[int] = [0, 51, 102]       # Dark Navy (Corporate)
    secondary: List[int] = [255, 102, 0]    # Accent (e.g., Orange)
    text: List[int] = [50, 50, 50]          # Dark Grey
    table_fill: List[int] = [245, 245, 245] # Light Grey
    success: List[int] = [0, 150, 0]        # Green
    danger: List[int] = [200, 0, 0]         # Red

class ThemeFonts(BaseModel):
    family_title: str = "Arial"
    family_body: str = "Calibri"
    size_h1: int = 40
    size_h2: int = 24
    size_body: int = 14

class PresentationTheme(BaseModel):
    colors: ThemeColors = ThemeColors()
    fonts: ThemeFonts = ThemeFonts()

# --- Slide Types ---

class SlideCover(BaseModel):
    type: Literal["cover"]
    title: str
    subtitle: Optional[str] = ""
    author: Optional[str] = ""

class SlideContent(BaseModel):
    type: Literal["content"]
    title: str
    points: List[str]

class TableColumn(BaseModel):
    key: str
    label: str
    width_ratio: float = 1.0  # Controls column width relative to others

class SlideTable(BaseModel):
    type: Literal["table"]
    title: str
    columns: List[TableColumn]
    rows: List[Dict[str, Any]]

class ChartData(BaseModel):
    categories: List[str]
    series_name: str
    values: List[float]

class SlideChart(BaseModel):
    type: Literal["chart"]
    title: str
    chart_type: Literal["COLUMN", "BAR", "LINE", "PIE"] = "COLUMN"
    data: ChartData

class CardItem(BaseModel):
    title: str
    value: str
    description: Optional[str] = ""

class SlideCards(BaseModel):
    type: Literal["cards"]
    title: str
    cards: List[CardItem]

class GanttTask(BaseModel):
    task: str
    start_week: int
    duration_weeks: int
    percent_complete: int = 0

class SlideGantt(BaseModel):
    type: Literal["gantt"]
    title: str
    total_weeks: int = 12
    tasks: List[GanttTask]

class SlideImage(BaseModel):
    type: Literal["image"]
    title: str
    image_path: str   # Note: You must upload the image to Colab folder
    caption: Optional[str] = ""

SlideType = Union[SlideCover, SlideContent, SlideTable, SlideChart, SlideCards, SlideGantt, SlideImage]

class PresentationConfig(BaseModel):
    file_name: str = "project_presentation.pptx"
    theme: PresentationTheme = PresentationTheme()
    slides: List[SlideType]

# ==============================================================================
# 3. THE RENDERING ENGINE (THE LOGIC)
# ==============================================================================

def get_rgb(c): return RGBColor(c[0], c[1], c[2])

def add_header(slide, title, theme):
    # Dynamic header placement
    shape = slide.shapes.add_textbox(Inches(0.5), Inches(0.4), Inches(12), Inches(1))
    p = shape.text_frame.paragraphs[0]
    p.text = title
    p.font.name = theme.fonts.family_title
    p.font.size = Pt(32)
    p.font.bold = True
    p.font.color.rgb = get_rgb(theme.colors.primary)
    
    # Decorative Line
    line = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, Inches(0.5), Inches(1.1), Inches(12.33), Inches(0.05))
    line.fill.solid()
    line.fill.fore_color.rgb = get_rgb(theme.colors.secondary)
    line.line.fill.background()

def render_cover(prs, slide, data: SlideCover, theme):
    # Centered Title
    box = slide.shapes.add_textbox(Inches(1), Inches(2.5), Inches(11.33), Inches(2))
    tf = box.text_frame
    p = tf.paragraphs[0]
    p.text = data.title
    p.alignment = PP_ALIGN.CENTER
    p.font.name = theme.fonts.family_title
    p.font.size = Pt(54)
    p.font.bold = True
    p.font.color.rgb = get_rgb(theme.colors.primary)

    # Subtitle
    if data.subtitle:
        p = tf.add_paragraph()
        p.text = "\n" + data.subtitle
        p.alignment = PP_ALIGN.CENTER
        p.font.size = Pt(28)
        p.font.color.rgb = get_rgb(theme.colors.text)

    # Footer/Author
    if data.author:
        fbox = slide.shapes.add_textbox(Inches(1), Inches(6.5), Inches(11.33), Inches(0.5))
        p = fbox.text_frame.paragraphs[0]
        p.text = data.author
        p.alignment = PP_ALIGN.CENTER
        p.font.color.rgb = get_rgb(theme.colors.secondary)

def render_content(prs, slide, data: SlideContent, theme):
    add_header(slide, data.title, theme)
    body = slide.shapes.add_textbox(Inches(0.5), Inches(1.5), Inches(12), Inches(5))
    tf = body.text_frame
    for point in data.points:
        p = tf.add_paragraph()
        p.text = point
        p.font.size = Pt(theme.fonts.size_h2)
        p.level = 0
        p.space_after = Pt(14)

def render_table(prs, slide, data: SlideTable, theme):
    add_header(slide, data.title, theme)
    rows = len(data.rows) + 1
    cols = len(data.columns)
    table = slide.shapes.add_table(rows, cols, Inches(0.5), Inches(1.5), Inches(12.33), Inches(0.5 * rows)).table
    
    # Headers
    for i, col in enumerate(data.columns):
        cell = table.cell(0, i)
        cell.text = col.label
        cell.fill.solid()
        cell.fill.fore_color.rgb = get_rgb(theme.colors.primary)
        cell.text_frame.paragraphs[0].font.color.rgb = RGBColor(255,255,255)
        cell.text_frame.paragraphs[0].font.bold = True
        
    # Data
    for r, row_data in enumerate(data.rows, start=1):
        for c, col_def in enumerate(data.columns):
            cell = table.cell(r, c)
            val = str(row_data.get(col_def.key, "-"))
            cell.text = val
            p = cell.text_frame.paragraphs[0]
            p.font.size = Pt(12)
            
            # Smart Color Logic
            val_lower = val.lower()
            if "completed" in val_lower or "track" in val_lower:
                p.font.color.rgb = get_rgb(theme.colors.success)
                p.font.bold = True
            elif "pending" in val_lower or "risk" in val_lower:
                p.font.color.rgb = get_rgb(theme.colors.danger)
                p.font.bold = True
            else:
                p.font.color.rgb = get_rgb(theme.colors.text)

def render_chart(prs, slide, data: SlideChart, theme):
    add_header(slide, data.title, theme)
    chart_data = CategoryChartData()
    chart_data.categories = data.data.categories
    chart_data.add_series(data.data.series_name, data.data.values)
    
    c_type = getattr(XL_CHART_TYPE, data.chart_type, XL_CHART_TYPE.COLUMN_CLUSTERED)
    chart = slide.shapes.add_chart(c_type, Inches(0.5), Inches(1.5), Inches(12), Inches(5), chart_data).chart
    chart.has_legend = True
    chart.legend.position = XL_LEGEND_POSITION.BOTTOM

def render_cards(prs, slide, data: SlideCards, theme):
    add_header(slide, data.title, theme)
    count = len(data.cards)
    margin = 0.5
    spacing = 0.3
    # Dynamic width calc
    card_width = (13.333 - (2 * margin) - ((count - 1) * spacing)) / count
    
    for i, card in enumerate(data.cards):
        left = margin + (i * (card_width + spacing))
        # Card Background
        shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(left), Inches(1.8), Inches(card_width), Inches(4))
        shape.fill.solid()
        shape.fill.fore_color.rgb = get_rgb(theme.colors.table_fill)
        shape.line.color.rgb = get_rgb(theme.colors.secondary)
        
        # Content
        tf = shape.text_frame
        p = tf.paragraphs[0]
        p.text = card.title
        p.font.bold = True
        p.font.size = Pt(18)
        p.font.color.rgb = get_rgb(theme.colors.primary)
        
        p = tf.add_paragraph()
        p.text = f"\n{card.value}"
        p.font.size = Pt(36)
        p.font.bold = True
        p.alignment = PP_ALIGN.CENTER
        
        if card.description:
            p = tf.add_paragraph()
            p.text = f"\n{card.description}"
            p.font.size = Pt(12)
            p.font.italic = True
            p.alignment = PP_ALIGN.CENTER

def render_gantt(prs, slide, data: SlideGantt, theme):
    add_header(slide, data.title, theme)
    
    # Timeline Parameters
    start_x = 3.0
    start_y = 2.0
    row_height = 0.6
    chart_width = 9.5
    unit_width = chart_width / data.total_weeks
    
    # Draw Weeks Header
    for w in range(1, data.total_weeks + 1):
        x = start_x + ((w-1) * unit_width)
        tb = slide.shapes.add_textbox(Inches(x), Inches(start_y - 0.5), Inches(unit_width), Inches(0.4))
        p = tb.text_frame.paragraphs[0]
        p.text = f"W{w}"
        p.font.size = Pt(10)
        p.alignment = PP_ALIGN.CENTER
        
        # Grid line
        line = slide.shapes.add_shape(MSO_SHAPE.LINE_INVERSE, Inches(x), Inches(start_y), Inches(0), Inches(len(data.tasks)*row_height))
        line.line.color.rgb = RGBColor(220,220,220)

    # Draw Tasks
    for i, task in enumerate(data.tasks):
        y = start_y + (i * row_height)
        
        # Label
        label = slide.shapes.add_textbox(Inches(0.5), Inches(y), Inches(2.4), Inches(row_height))
        p = label.text_frame.paragraphs[0]
        p.text = task.task
        p.font.size = Pt(12)
        p.alignment = PP_ALIGN.RIGHT
        
        # Bar
        bar_x = start_x + ((task.start_week - 1) * unit_width)
        bar_w = task.duration_weeks * unit_width
        
        # Visual styling based on completion
        color = theme.colors.success if task.percent_complete == 100 else theme.colors.primary
        
        bar = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(bar_x), Inches(y+0.1), Inches(bar_w), Inches(row_height-0.2))
        bar.fill.solid()
        bar.fill.fore_color.rgb = get_rgb(color)
        
        # Percent Text
        p = bar.text_frame.paragraphs[0]
        p.text = f"{task.percent_complete}%"
        p.font.size = Pt(9)
        p.alignment = PP_ALIGN.CENTER

def render_image(prs, slide, data: SlideImage, theme):
    add_header(slide, data.title, theme)
    if os.path.exists(data.image_path):
        # Auto center logic
        pic = slide.shapes.add_picture(data.image_path, Inches(1), Inches(1.5), height=Inches(5))
        pic.left = int((Inches(13.333) - pic.width)/2)
    else:
        # Fallback if image missing
        box = slide.shapes.add_textbox(Inches(1), Inches(3), Inches(10), Inches(2))
        box.text_frame.text = f"MISSING IMAGE: {data.image_path}"

